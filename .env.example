# --- Servidor API ---
PORT=3000
NODE_ENV=development

# --- Banco de Dados MySQL ---
DB_HOST=localhost
DB_PORT=3307
DB_USER=root
DB_PASS=123456
DB_NAME=simple_order_system

# --- Autenticação JWT ---
JWT_SECRET=sua_chave_jwt_secreta_super_segura_aqui

# --- CORS & Comunicação entre Apps ---
# URL(s) do frontend permitidas a chamar a API (separadas por vírgula se houver mais de uma)
FRONTEND_URL=http://localhost:5173

# --- Frontend Web ---
# URL base que o frontend usará para chamar a API
VITE_API_URL=http://localhost:3000

# --- Banco de Testes & Logs do Sequelize ---
 TEST_DB_NAME=simple_order_system_test

# --- Carga Inicial de Usuário Admin (npm run db:seed) ---
 INITIAL_ADMIN_EMAIL=admin@restaurant.com
 INITIAL_ADMIN_PASS=admin123

# --- URL Pública da API (para Webhooks do Mercado Pago e integrações) ---
 API_BASE_URL=http://localhost:3000